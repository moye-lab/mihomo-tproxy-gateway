[Unit]
Description=Mihomo Daemon, A rule based proxy in Go.
After=network.target network-online.target nss-lookup.target systemd-resolved.service
Wants=network-online.target
# 防崩溃循环刷日志：5 分钟内启动失败超过 5 次就不再自动重启，
# 等人工介入（否则 Restart=always 会以 5 秒间隔无限重试）。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
ExecStart=/usr/local/bin/mihomo -d /etc/mihomo
# 注意：这里用 ExecStartPost 而不是 ExecStartPre —— 必须等 mihomo 先监听
# 好 TPROXY 端口，再挂 iptables 规则。反过来的话，服务刚启动的一小段
# 时间窗口里，被转发到该端口的包会因为还没有监听者而被丢弃，表现为偶发、
# 难复现的连接失败。
ExecStartPost=/bin/bash /etc/mihomo/tproxy.sh
# 服务停止后必须清掉 TPROXY/DNS 规则，否则客户端流量仍被转发到无人
# 监听的 7893 端口形成黑洞。复用 tproxy.sh stop（不另写清理逻辑）；
# restart 时 stop→start 顺序下，清理后由 ExecStartPost 重新建规则。
# ExecStopPost 失败只记日志，不影响停止操作本身。
ExecStopPost=/bin/bash /etc/mihomo/tproxy.sh stop
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
